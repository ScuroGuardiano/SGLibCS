<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <Nullable>enable</Nullable>

        <PackageId>ScuroGuardiano.Slugify</PackageId>
        <Version>1.0.0</Version>
        <Authors>ScuroGuardiano</Authors>
        <Description>Package for converting arbitrary text to url friendly slug</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/ScuroGuardiano/</RepositoryUrl>
        <PackageProjectUrl>https://github.com/ScuroGuardiano/SGLibCS</PackageProjectUrl>

        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>slug;slugify</PackageTags>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

        <RootNamespace>ScuroGuardiano.Slugify</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../LICENSE"
              Pack="true"
              PackagePath="" />

        <None Include="../NOTICE"
              Pack="true"
              PackagePath="" />

        <None Include="../APACHE-LUCENE-LICENSE"
              Pack="true"
              PackagePath="" />
        
        <None Include="../README.md"
              Pack="true"
              PackagePath="" />
    </ItemGroup>
</Project>
