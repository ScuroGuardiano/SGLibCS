<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <!-- Web SDK domyślnie wyłącza pakowanie -->
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>mdlive</ToolCommandName>
        <PackageId>ScuroGuardiano.MdLive</PackageId>
        <Version>0.1.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="StarFederation.Datastar" Version="1.4.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ScuroGuardiano.MdLive.ConfigBase\ScuroGuardiano.MdLive.ConfigBase.csproj" />
    </ItemGroup>

</Project>
