<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <!-- Web SDK domyślnie wyłącza pakowanie -->
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>mdlive</ToolCommandName>
        <PackageId>ScuroGuardiano.MdLive</PackageId>
        <!-- Przy publikacji wersję nadpisuje tag release'a (nuget-publish.yml) -->
        <Version>0.1.0</Version>
        <Authors>ScuroGuardiano</Authors>
        <Description>Live preview of Markdown rendered with your own Markdig pipeline and styles, driven from an editor such as Neovim.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/ScuroGuardiano/SGLibCS/tree/master/MdLive</RepositoryUrl>
        <PackageProjectUrl>https://github.com/ScuroGuardiano/SGLibCS/tree/master/MdLive</PackageProjectUrl>
        <PackageTags>markdown;markdig;preview;live-preview;neovim</PackageTags>
        <!-- Linki w README są bezwzględne, bo nuget.org nie rozwiązuje względnych -->
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <!-- Roslyn przynosi tłumaczenia komunikatów na 13 języków, diagnostyki wystarczą po angielsku -->
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="StarFederation.Datastar" Version="1.4.0" />
        <!-- Kompilacja .mdlive/config.csx. Samo CSharp, bez .Scripting, patrz Scripting/ScriptCompiler.cs -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ScuroGuardiano.MdLive.Tests" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ScuroGuardiano.MdLive.ConfigBase\ScuroGuardiano.MdLive.ConfigBase.csproj" />
    </ItemGroup>

</Project>
